{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Usuario",
    "type": "object",
    "properties": {
        "nombreUsuario": {"type": "string", "minLength": 3, "maxLength": 50},
        "email": {"type": "string", "format": "email"},
        "nombre": {"type": "string", "minLength": 3, "maxLength": 100},
        "apellido": {"type": "string", "minLength": 3, "maxLength": 100},
        "password": {"type": "string", "minLength": 4}
    },
    "required": ["nombreUsuario", "email", "nombre", "apellido", "password"],
    "additionalProperties": false
}