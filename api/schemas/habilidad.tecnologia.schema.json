{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HabilidadTecnologia",
    "type": "object",
    "properties": {
        "idUsuario": {"type": "integer", "minimum": 1},
        "nombre": {"type": "string", "minLength": 1, "maxLength": 50},
        "nivel": {"type": "string", "enum": ["Básico", "Intermedio", "Avanzado", "Experto"]}
    },
    "required": ["idUsuario", "nombre", "nivel"],
    "additionalProperties": false
}